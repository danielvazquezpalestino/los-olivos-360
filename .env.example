# Copia este archivo como .env y ajusta los valores locales.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=los_olivos_360

# Secreto para firmar el token de sesión del panel de administración.
SESSION_SECRET=cambia-este-secreto

# --- Videollamadas (LiveKit) ------------------------------------------------
# Copia la URL y las claves desde el panel de LiveKit Cloud
# (Settings -> Keys) o de tu servidor self-hosted. NUNCA las pongas en el
# frontend ni las subas al repositorio: el navegador sólo recibe el token
# firmado que emite el backend.
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=cambia-esta-api-key
LIVEKIT_API_SECRET=cambia-este-api-secret
